 "schema": "postfiat-event-log-rotation-record-v1",
 "recorded_at": "2026-09-29T12:39:20Z",
 "release_id": "combined-fastpay-20260928",
 "source_commit": "c93b2137",
 "scope": "transport-validator-events.ndjson on the six validators; no service restart, no chain action, no file removed",
 "code_findings": {
  "writer": "crates/node/src/transport_protocol.rs open_transport_event_log: OpenOptions create+append, opened once at startup",
  "descriptor": "crates/node/src/transport_runtime.rs transport_validator_serve_inner holds one File in Arc<Mutex<Option<File>>> for the process lifetime; each event is write_all + newline",
  "size_cap_or_rotation": "none: only --event-log PATH; no setting in the unit or validator-N.transport.env; no reopen (only SIGTERM/SIGINT handlers, SIGHUP would terminate)",
  "readers": "none in code; the 'last 200 events' reads were ad-hoc operator tails; RPC event_log_writable covers rpc-events.ndjson only; indices are in-memory counters, not byte offsets",
  "truncation_safe": "yes: O_APPEND (observed fd flags 02102001) sends the next write to the new end of file, no sparse hole",
  "unchanged_on_main": "transport_protocol.rs and transport_runtime.rs identical between c93b2137 and main"
 },
 "mechanism": {
  "rule_path": "/etc/logrotate.d/postfiat-validator-events",
  "rule_text": "/var/log/postfiat/validator-*/transport-validator-events.ndjson {\n    size 2G\n    rotate 3\n    compress\n    delaycompress\n    missingok\n    notifempty\n    copytruncate\n}\n",
  "schedule": "logrotate.timer, daily at 00:00 UTC",
  "why_copytruncate": "the node holds one O_APPEND descriptor and never reopens; rename rotation would keep writing to the renamed file",
  "why_backlog_archive_first": "copytruncate first writes a raw copy; the 13.87 GB backlog exceeded free space on validator-1 (9.88 GB) and validator-0 (7.67 GB) on the root filesystem shared with /var/lib/postfiat, so the forced run or the next timer run would have filled the chain disk. The backlog was streamed into a sha256-verified zstd archive (about 4.18 GB), then the live file was truncated in place. validator-2 (40.7 MB) used the forced copytruncate directly",
  "copytruncate_loss_window": "events written between the start of the copy and the truncate are lost. At 60 MB/s (slowest sequential read in the archive pass) a 2 GiB copy takes about 36 s; at the long-run average of about 2.2 KB/s (190 MB/day, 12.3 KB per event, validator-1 2026-07-17 to 2026-09-28) that is about 6 events. Burst rate is not measurable: events carry no timestamps and all six files were idle (0 bytes in 20 s, last write 2026-09-28 08:35-08:37Z)",
  "archive_truncation_loss_window": "stat-then-truncate, with any growth appended to the archive first; no growth occurred on any host, so no event was lost"
 },
 "new_events_after_rotation": "not observed: no transport traffic reached any validator between the rotation and the final read at 12:39Z; each node's fd 3 still points at the live path (same inode) with O_APPEND",
 "brief_correction": "validator-2's file was 40,702,967 bytes, not 13.9 GB",
 "rollback": "rm /etc/logrotate.d/postfiat-validator-events on each host; archives and .1 files stay",
