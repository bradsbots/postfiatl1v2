#!/usr/bin/env python3
"""Regenerate docs/handoffs/index.md, the newest-first list of dated handoffs.

Run this after adding or renaming a handoff instead of editing mkdocs.yml:

    scripts/docs-handoffs-index           # rewrite docs/handoffs/index.md
    scripts/docs-handoffs-index --check   # exit 1 if the index is stale

Files that match the handoff filename pattern
(``YYYY-MM-DD___operator__simple_title.md``, see docs/handoffs/README.md and
.gitignore) are listed. Older dated files that predate the pattern
(``YYYY-MM-DD_title.md``) are listed only when Git already tracks them, so an
ignored local draft never reaches the index. The page title is the file's
first ``# `` heading. The script uses only the Python standard library.
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
HANDOFFS = ROOT / "docs" / "handoffs"
INDEX = HANDOFFS / "index.md"
STANDARD_URL = (
    "https://github.com/postfiatorg/postfiatl1v2/blob/main/docs/handoffs/README.md"
)
FILENAME = re.compile(
    r"^(?P<date>\d{4}-\d{2}-\d{2})___(?P<operator>[a-z0-9_]+?)__(?P<slug>[a-z0-9_]+)\.md$"
)
LEGACY_FILENAME = re.compile(r"^(?P<date>\d{4}-\d{2}-\d{2})_(?P<slug>[A-Za-z0-9_-]+)\.md$")


def tracked_names(handoffs_dir: Path) -> set[str]:
    try:
        result = subprocess.run(
            ["git", "ls-files", "--", "."],
            cwd=handoffs_dir,
            capture_output=True,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return set()
    return {Path(line).name for line in result.stdout.splitlines()}


def title_of(path: Path, slug: str) -> str:
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return slug.replace("_", " ").capitalize()


def table_cell(text: str) -> str:
    return text.replace("\\", "\\\\").replace("|", "\\|")


def render(handoffs_dir: Path) -> str:
    rows = []
    tracked = None
    for path in handoffs_dir.iterdir():
        if not path.is_file():
            continue
        match = FILENAME.match(path.name)
        operator = match["operator"] if match else None
        if not match:
            match = LEGACY_FILENAME.match(path.name)
            if not match:
                continue
            if tracked is None:
                tracked = tracked_names(handoffs_dir)
            if path.name not in tracked:
                continue
        rows.append((match["date"], operator, title_of(path, match["slug"]), path.name))
    # Newest date first; files from the same day sort by filename so the
    # output is deterministic.
    rows.sort(key=lambda row: row[3])
    rows.sort(key=lambda row: row[0], reverse=True)

    lines = [
        "# Handoffs",
        "",
        "<!-- Generated by scripts/docs-handoffs-index. Do not edit by hand. -->",
        "",
        "Dated handoffs are internal engineering records: point-in-time notes",
        "passed between operators and agents. They are not current operating",
        "truth. For the network as it is now, read",
        "[Network Status](../status/network-status.md).",
        "",
        f"The filename and content rules are in the [handoff standard]({STANDARD_URL})",
        "(`docs/handoffs/README.md`). This page is regenerated by",
        "`scripts/docs-handoffs-index`; do not add handoffs to `mkdocs.yml`.",
        "",
        f"{len(rows)} handoffs, newest first.",
    ]
    month = None
    for date, operator, title, name in rows:
        if date[:7] != month:
            month = date[:7]
            lines += ["", f"## {month}", "", "| Date | Operator | Handoff |", "| --- | --- | --- |"]
        who = f"`{operator}`" if operator else "not recorded"
        lines.append(f"| {date} | {who} | [{table_cell(title)}]({name}) |")
    return "\n".join(lines) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--check",
        action="store_true",
        help="do not write; exit 1 if docs/handoffs/index.md is out of date",
    )
    args = parser.parse_args()
    expected = render(HANDOFFS)
    current = INDEX.read_text(encoding="utf-8") if INDEX.exists() else None
    if args.check:
        if current != expected:
            print(
                "docs/handoffs/index.md is stale; run scripts/docs-handoffs-index",
                file=sys.stderr,
            )
            return 1
        print("docs/handoffs/index.md is up to date")
        return 0
    if current != expected:
        INDEX.write_text(expected, encoding="utf-8")
        print(f"wrote {INDEX.relative_to(ROOT)}")
    else:
        print(f"{INDEX.relative_to(ROOT)} already up to date")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
