#!/usr/bin/env bash
set -euo pipefail

DATA_DIR="${DATA_DIR:-.postfiat/node0}"
TO="${TO:-pfrecipient000000000000000000000000000000}"
AMOUNT="${AMOUNT:-100}"

if [ ! -d "$DATA_DIR" ]; then
  echo "node data dir does not exist: $DATA_DIR" >&2
  echo "run scripts/node-init first or set DATA_DIR to an initialized node directory" >&2
  exit 2
fi

# Ordered batch path, as scripts/devnet-submit-transfer uses: `transfer`
# mutates state outside ordered blocks and is refused unless
# POSTFIAT_ALLOW_DIRECT_STATE=1 (debug-only).
batch_dir="$DATA_DIR/batches"
mkdir -p "$batch_dir"
batch_file="$batch_dir/transfer-$(date +%s%N).json"

cargo run -p postfiat-node --bin postfiat-node -- batch-transfer \
  --data-dir "$DATA_DIR" \
  --to "$TO" \
  --amount "$AMOUNT" \
  --batch-file "$batch_file" >/dev/null

cargo run -p postfiat-node --bin postfiat-node -- apply-batch \
  --data-dir "$DATA_DIR" \
  --batch-file "$batch_file"
