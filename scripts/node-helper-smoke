#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="${BASE_DIR:-reports/node-helper-smoke/node}"
LOG_DIR="${LOG_DIR:-reports/node-helper-smoke/logs}"
REPORT="${REPORT:-reports/node-helper-smoke/node-helper-smoke-$(date -u +%Y%m%dT%H%M%SZ).json}"
CHAIN_ID="${CHAIN_ID:-postfiat-local}"
NODE_ID="${NODE_ID:-validator-0}"

require_command() {
  local command="$1"
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "missing required command: $command" >&2
    exit 1
  fi
}

on_error() {
  local rc="$?"
  trap - ERR
  echo "node helper smoke failed with exit code $rc" >&2
  echo "logs: $LOG_DIR" >&2
  for file in "$LOG_DIR"/*; do
    [ -f "$file" ] || continue
    echo "== $file ==" >&2
    sed -n '1,120p' "$file" >&2 || true
  done
  exit "$rc"
}
trap on_error ERR

require_command cargo
require_command date
require_command dirname
require_command grep
require_command jq
require_command mkdir
require_command sed

case "$BASE_DIR" in
  ""|"/"|"."|"./"|".."|"../")
    echo "BASE_DIR must not be empty, /, ., or .." >&2
    exit 2
    ;;
esac
case "$LOG_DIR" in
  ""|"/"|"."|"./"|".."|"../")
    echo "LOG_DIR must not be empty, /, ., or .." >&2
    exit 2
    ;;
esac

rm -rf "$BASE_DIR" "$LOG_DIR"
mkdir -p "$BASE_DIR" "$LOG_DIR" "$(dirname "$REPORT")"

init_stdout="$LOG_DIR/node-init.stdout"
init_stderr="$LOG_DIR/node-init.stderr"
run_json="$LOG_DIR/node-run.json"
run_trace="$LOG_DIR/node-run.trace"
status_json="$LOG_DIR/node-status.json"
status_stderr="$LOG_DIR/node-status.stderr"

DATA_DIR="$BASE_DIR" \
CHAIN_ID="$CHAIN_ID" \
NODE_ID="$NODE_ID" \
  scripts/node-init >"$init_stdout" 2>"$init_stderr"

DATA_DIR="$BASE_DIR" \
  bash -x scripts/node-run >"$run_json" 2>"$run_trace"

grep -q -- '--bin postfiat-node' "$run_trace"
grep -q -- '--unsafe-devnet-json-storage' "$run_trace"

DATA_DIR="$BASE_DIR" scripts/node-status >"$status_json" 2>"$status_stderr"

jq -e \
  --arg chain_id "$CHAIN_ID" \
  --arg node_id "$NODE_ID" \
  '.chain_id == $chain_id
    and .node_id == $node_id
    and .status == "running"
    and .block_height == 0
    and .storage.storage_format == "postfiat-json-jsonl-legacy"
    and .storage.integrity_status == "legacy_authenticated"' \
  "$run_json" >/dev/null

jq -e \
  --arg chain_id "$CHAIN_ID" \
  --arg node_id "$NODE_ID" \
  '.chain_id == $chain_id
    and .node_id == $node_id
    and .status == "running"
    and .block_height == 0
    and .storage.storage_format == "postfiat-json-jsonl-legacy"
    and .storage.integrity_status == "legacy_authenticated"' \
  "$status_json" >/dev/null

jq -n -e \
  --slurpfile run "$run_json" \
  --slurpfile status "$status_json" \
  '$run[0].state_root == $status[0].state_root
    and $run[0].block_tip_hash == $status[0].block_tip_hash
    and $run[0].storage.finalized_state_root == $status[0].storage.finalized_state_root' \
  >/dev/null

jq -n \
  --arg schema "postfiat-node-helper-smoke-v1" \
  --arg base_dir "$BASE_DIR" \
  --arg log_dir "$LOG_DIR" \
  --arg run_json "$run_json" \
  --arg status_json "$status_json" \
  --slurpfile run "$run_json" \
  --slurpfile status "$status_json" \
  '{
    schema: $schema,
    node_helper_ok: true,
    paths: {
      base_dir: $base_dir,
      log_dir: $log_dir,
      run_json: $run_json,
      status_json: $status_json
    },
    command_checks: {
      cargo_binary_pinned: true,
      unsafe_devnet_json_storage_acknowledged: true
    },
    node: {
      chain_id: $run[0].chain_id,
      node_id: $run[0].node_id,
      status: $run[0].status,
      block_height: $run[0].block_height,
      block_tip_hash: $run[0].block_tip_hash,
      state_root: $run[0].state_root
    },
    storage: {
      storage_format: $run[0].storage.storage_format,
      storage_schema: $run[0].storage.storage_schema,
      backend: $run[0].storage.backend,
      backend_version: $run[0].storage.backend_version,
      generation: $run[0].storage.generation,
      integrity_status: $run[0].storage.integrity_status,
      finalized_height: $run[0].storage.finalized_height,
      finalized_state_root: $run[0].storage.finalized_state_root
    },
    status_readback_matches_run: (
      $run[0].state_root == $status[0].state_root
      and $run[0].block_tip_hash == $status[0].block_tip_hash
      and $run[0].storage.finalized_state_root == $status[0].storage.finalized_state_root
    )
  }' >"$REPORT"

cat "$REPORT"
