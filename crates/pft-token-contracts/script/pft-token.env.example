# PFTToken deployment values for script/DeployPFTToken.s.sol (Base; test
# deployments on Base Sepolia, chain id 84532). Placeholders only: the script
# refuses any value that still contains "replace".
#
# The Base Sepolia RPC URL and the one-time deployer key are passed to
# `forge script` on the command line (--rpc-url, --interactives 1) and are
# never stored in this file or in .env.

PFT_TOKEN_NAME=replace_with_token_name
PFT_TOKEN_SYMBOL=replace_with_token_symbol
# Whole supply in six-decimal units (1 PFT = 1000000 units).
PFT_TOKEN_TOTAL_SUPPLY=replace_with_total_supply_in_six_decimal_units
# The treasury Safe multisig that receives the whole supply; never a single key.
PFT_TOKEN_TREASURY=0xreplace_with_treasury_safe_address
