# PFTToken deployment values for script/DeployPFTToken.s.sol (Base, chain id
# 8453; test deployments on Base Sepolia, chain id 84532). Placeholders only:
# the script refuses any value that is empty, blank or contains "replace" in
# any casing. Keep the filled copy outside the repository (*.env is ignored).
#
# The RPC URL and the one-time deployer key are passed to `forge script` on the
# command line (--rpc-url, --ledger or --interactives 1) and are never stored in
# this file or in .env.

# 8453 (Base) or 84532 (Base Sepolia); must equal the RPC's chain id.
PFT_TOKEN_CHAIN_ID=replace_with_8453_or_84532
# At most 31 bytes (OpenZeppelin EIP712 ShortString).
PFT_TOKEN_NAME=replace_with_token_name
PFT_TOKEN_SYMBOL=replace_with_token_symbol
# The supply twice: in six-decimal units and in whole PFT (units = PFT * 1000000).
PFT_TOKEN_TOTAL_SUPPLY=replace_with_total_supply_in_six_decimal_units
PFT_TOKEN_TOTAL_SUPPLY_PFT=replace_with_total_supply_in_whole_pft
# The treasury Safe (v1.4.1, threshold >= 2) that receives the whole supply.
PFT_TOKEN_TREASURY=0xreplace_with_treasury_safe_address

# Required for the real deployment (writes deployments/...; never with a test switch).
# PFT_TOKEN_REAL_DEPLOYMENT=1
# PFT_TOKEN_SOURCE_COMMIT=replace_with_the_deployed_git_commit

# Test-only switches for a local anvil dry run on chain id 84532. Never set them
# for a real deployment; on 8453 the script refuses them.
# PFT_TOKEN_ALLOW_EOA_TREASURY=1
# PFT_TOKEN_ALLOW_USED_DEPLOYER=1
